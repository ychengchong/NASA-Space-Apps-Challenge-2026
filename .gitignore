# Secrets and local credentials; example variable names may be committed.
.env
.env.*
!.env.example
*.pem
*.key
.aws/

# Python environments and generated caches.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Frontend dependencies, builds and local test outputs.
node_modules/
frontend/dist/
.next/
.nuxt/
.turbo/
dist/
build/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# Local caches (the pre-warmed backend/data/cache.sqlite is committed on purpose).
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
# A local working copy of the cache, so local runs leave the committed file unchanged.
backend/data/cache.local.sqlite

# Large/private inputs, generated artifacts and operational state.
data/raw/
data/processed/
artifacts/
runs/
state/
logs/
tmp/

# Personal notes.
/docs-personal/

# OS
.DS_Store
Thumbs.db
