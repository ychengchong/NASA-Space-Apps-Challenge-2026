# Copy to .env and fill in. Never commit .env.

# Key for the built-in AI on Claude. Server only.
ANTHROPIC_API_KEY=
# Key for the built-in AI on OpenAI. Server only.
OPENAI_API_KEY=
# The AI's provider: anthropic or openai. Empty means Claude when ANTHROPIC_API_KEY is set,
# otherwise OpenAI when OPENAI_API_KEY is set. With the named provider's key empty, the AI is off.
AI_PROVIDER= openai

# Turns the AI on or off.
AI_ENABLED=true
# Model id. Empty means the provider's default: claude-opus-5-5 on Claude, gpt-6-luna on OpenAI.
AI_MODEL=
# Model round trips in one turn.
AI_MAX_ITERATIONS=6
# User turns in one conversation.
AI_MAX_TURNS=20
# AI turns per day, across all users.
AI_DAILY_TURNS=500
# AI turns per address per minute.
AI_RATE_PER_MINUTE=10
# Other requests per address per minute.
RATE_LIMIT_PER_MINUTE=120

# Used to build case links and the MCP hostname allowlist, such as https://trend-detective.example.org
# Required in production.
PUBLIC_BASE_URL=
# Location of the SQLite file. Defaults to backend/data/cache.sqlite.
CACHE_PATH=

# Port the server listens on inside the container. Read by the Dockerfile's start command, not
# by the app. Defaults to 8000.
PORT=
# Addresses whose X-Forwarded-For header gives the visitor's address, for the rate limits:
# comma-separated addresses or ranges, such as 10.0.0.0/8. Read by uvicorn in the container, not
# by the app. The image's default trusts loopback alone; set it to the address range of the
# platform's proxy. * trusts every address, so use it only when nothing but the proxy can reach
# the container.
FORWARDED_ALLOW_IPS=127.0.0.1
