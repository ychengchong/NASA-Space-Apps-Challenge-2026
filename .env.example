# Copy to .env. Never commit real credentials.
PUBLIC_BASE_URL=
PORT=8000
FORWARDED_ALLOW_IPS=127.0.0.1
RATE_LIMIT_PER_MINUTE=120
# Defaults use the persistent state directory at the repository/container root.
CACHE_PATH=
OPERATIONAL_DB_PATH=
SNAPSHOT_PATH=

# AI is off until an exact model has been evaluated and deliberately enabled.
AI_PROVIDER=disabled
AI_ENABLED=false
AI_EVALUATED=false
AI_MODEL=
AI_DAILY_TURNS=500
AI_RATE_PER_MINUTE=10

# Local Ollama: exact tag AND digest from your installed model; no automatic download.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL_DIGEST=

# Optional hosted provider; server credentials only. No automatic paid fallback.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Integer microdollars: USD 1 = 1000000. Prices are microdollars per million tokens.
# Supply verified rates for the exact selected model and maintain them yourself.
AI_DAILY_BUDGET_MICROUSD=0
AI_INPUT_MICROUSD_PER_MILLION=0
AI_OUTPUT_MICROUSD_PER_MILLION=0
# Enable only after mounting durable state; reservations survive restart/redeploy.
AI_BUDGET_DURABLE=false

# Retrieval (RAG) for guided discovery and explanations: OpenAI only, off by default.
# RAG_VECTOR_STORE_ID and RAG_CORPUS_VERSION come from the owner-run corpus upload; the version
# must equal backend/data/corpus/manifest.json's corpus_version, or discovery and explanation
# stay off (the planner is unaffected).
RAG_ENABLED=false
RAG_VECTOR_STORE_ID=
RAG_CORPUS_VERSION=
# Integer microdollars per vector-store search call; supply the verified current rate.
RAG_SEARCH_MICROUSD_PER_CALL=0
# Set each only after its held-out evaluation suite has been run and reviewed.
RAG_EVALUATED=false
DISCOVERY_EVALUATED=false
