# Copy to .env. Never commit real credentials.
PUBLIC_BASE_URL=
PORT=8000
FORWARDED_ALLOW_IPS=127.0.0.1
RATE_LIMIT_PER_MINUTE=120
# Defaults use the persistent state directory at the repository/container root.
CACHE_PATH=
OPERATIONAL_DB_PATH=
SNAPSHOT_PATH=

# AI is off until an exact model has been evaluated and deliberately enabled.
AI_PROVIDER=disabled
AI_ENABLED=false
AI_EVALUATED=false
AI_MODEL=
AI_DAILY_TURNS=500
AI_RATE_PER_MINUTE=10

# Local Ollama: exact tag AND digest from your installed model; no automatic download.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL_DIGEST=

# Optional hosted provider; server credentials only. No automatic paid fallback.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Integer microdollars: USD 1 = 1000000. Prices are microdollars per million tokens.
# Supply verified rates for the exact selected model and maintain them yourself.
AI_DAILY_BUDGET_MICROUSD=0
AI_INPUT_MICROUSD_PER_MILLION=0
AI_OUTPUT_MICROUSD_PER_MILLION=0
# Enable only after mounting durable state; reservations survive restart/redeploy.
AI_BUDGET_DURABLE=false
