# Copy to .env. Never commit real credentials.
PUBLIC_BASE_URL=
PORT=8000
FORWARDED_ALLOW_IPS=127.0.0.1
RATE_LIMIT_PER_MINUTE=120
# Defaults use the persistent state directory at the repository/container root.
CACHE_PATH=
OPERATIONAL_DB_PATH=
SNAPSHOT_PATH=

# AI-enabled hackathon demo template, selected by the team on 15 November 2026.
# Supply your own key and corpus settings below; empty credentials keep AI unavailable.
# Experimental: evaluated flags enable features, but do not certify a passed quality gate.
AI_PROVIDER=openai
AI_ENABLED=true
AI_EVALUATED=true
AI_MODEL=gpt-6-luna
AI_DAILY_TURNS=500
AI_RATE_PER_MINUTE=10

# Local Ollama: exact tag AND digest from your installed model; no automatic download.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL_DIGEST=

# Optional hosted provider; server credentials only. No automatic paid fallback.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Integer microdollars: USD 1 = 1000000. Prices are microdollars per million tokens.
# Supply verified rates for the exact selected model and maintain them yourself.
AI_DAILY_BUDGET_MICROUSD=1000000
# gpt-6-luna standard short-context rates verified 2026-11-15:
# https://developers.openai.com/api/docs/pricing
AI_INPUT_MICROUSD_PER_MILLION=100000
AI_OUTPUT_MICROUSD_PER_MILLION=500000
# Keep the default local state directory across restarts; mount persistent state when hosting.
# This flag declares that budget reservations survive restart/redeploy.
AI_BUDGET_DURABLE=true

# Retrieval (RAG) for guided discovery and explanations: OpenAI only. On by default (owner
# decision, 15 November 2026, although the evaluation gates were not met; see
# docs/evaluation-results.md), but it works only once the AI and the store below are set.
# RAG_VECTOR_STORE_ID and RAG_CORPUS_VERSION come from the owner-run corpus upload; the version
# must equal backend/data/corpus/manifest.json's corpus_version, or discovery and explanation
# stay off (the planner is unaffected).
RAG_ENABLED=true
RAG_VECTOR_STORE_ID=
RAG_CORPUS_VERSION=
# Integer microdollars per vector-store search call; supply the verified current rate.
# Conservative search reservation; direct vector-store search is not a Responses tool call.
RAG_SEARCH_MICROUSD_PER_CALL=2500
# true turns explanations (RAG_EVALUATED) and discovery (DISCOVERY_EVALUATED) on (the owner's
# decision of 15 November 2026, although the explanation gate is not met); set false to turn
# either off.
RAG_EVALUATED=true
DISCOVERY_EVALUATED=true
